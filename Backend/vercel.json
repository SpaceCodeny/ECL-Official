{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/ping.js": {
      "maxDuration": 10,
      "memory": 256
    }
  },
  "rewrites": [
    { "source": "/ping", "destination": "/api/ping" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "SERVERLESS": "true"
  }
}
