{
  "version": 2,
  "builds": [
    {
      "src": "api/ping.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb",
        "includeFiles": [
          "src/**",
          "prisma/schema.prisma",
          "tsconfig.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/ping",
      "dest": "/api/ping.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "env": {
    "SERVERLESS": "true"
  }
}
