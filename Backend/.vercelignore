# Ignorar arquivos desnecessários no deploy da Vercel

# Variáveis de ambiente locais
.env
.env.local
.env.supabase
.env.vercel

# Testes (não precisam ir para produção)
test/
coverage/
**/*.spec.ts
**/*.e2e-spec.ts

# Arquivos de desenvolvimento local
uploads/
*.log
Procfile
docker-compose.yml

# Seed (não executar em produção via deploy)
prisma/seed.ts

# dist local (a Vercel faz o build dela mesma)
dist/
