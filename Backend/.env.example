# ===== Aplicação =====
NODE_ENV=development
PORT=3001
APP_NAME=Elite Champions League
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# ===== Banco de dados (PostgreSQL) =====
# Use a mesma string do docker-compose.yml
DATABASE_URL=postgresql://ecl:ecl_dev@localhost:5432/ecl?schema=public
POSTGRES_USER=ecl
POSTGRES_PASSWORD=ecl_dev
POSTGRES_DB=ecl
POSTGRES_PORT=5432

# ===== Autenticação JWT =====
# Gere com: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-please-use-openssl-rand-base64-64
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-openssl-rand-base64-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Primeiro administrador (bootstrap seguro) =====
# Usado apenas no seed de desenvolvimento — NÃO usar em produção
ADMIN_BOOTSTRAP_EMAIL=admin@ecl.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!Admin2025
ADMIN_BOOTSTRAP_USERNAME=ecl_admin

# ===== E-mail (provedor real obrigatório para envio efetivo) =====
# Se não configurado, o envio fica desativado e isso é reportado explicitamente
MAIL_PROVIDER=none
MAIL_FROM=noreply@ecl.local
# Exemplo SMTP:
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ===== Uploads =====
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# ===== Rate limiting =====
THROTTLE_TTL=60
THROTTLE_LIMIT=60
