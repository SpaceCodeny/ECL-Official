# ═══════════════════════════════════════════════════════════════════════════
# ECL Backend - Express API - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=Elite Champions League
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (com pooling para produção)
DATABASE_URL=postgresql://user:password@host:6543/database?pgbouncer=true

# URL direta sem pooling (necessária para migrations)
DIRECT_URL=postgresql://user:password@host:5432/database

# ─── JWT Authentication ─────────────────────────────────────────────────────
# Secrets devem ter no mínimo 16 caracteres
# IMPORTANTE: Use valores diferentes em produção!
JWT_ACCESS_SECRET=change-me-min-16-chars-access-secret
JWT_REFRESH_SECRET=change-me-min-16-chars-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Admin Bootstrap ────────────────────────────────────────────────────────
# Usado pelo seed para criar conta admin inicial (opcional)
ADMIN_BOOTSTRAP_EMAIL=admin@ecl.local
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@123456

# ─── Email ──────────────────────────────────────────────────────────────────
MAIL_PROVIDER=none
MAIL_FROM=noreply@ecl.local

# Se MAIL_PROVIDER=smtp, configure:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ─── File Uploads ───────────────────────────────────────────────────────────
# "local" para desenvolvimento, "supabase" para produção
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# Supabase Storage (necessário quando UPLOAD_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=ecl-assets

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# TTL em segundos, LIMIT = máximo de requisições por TTL
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ─── Serverless Flag ────────────────────────────────────────────────────────
# Automaticamente definido como "true" na Vercel
# SERVERLESS=false

# ─── Picks & Bans Integration ───────────────────────────────────────────────
# URL do backend do sistema de picks & bans
PICKS_BANS_API_URL=https://peaks-and-bans-backend.vercel.app
# URL do frontend do sistema de picks & bans  
PICKS_BANS_FRONTEND_URL=https://peaks-and-bans.vercel.app
# URL do frontend ECL (para resolver logos relativas)
FRONTEND_URL=https://ecl-official.vercel.app
# Chave compartilhada entre ECL e Picks & Bans (deve ser igual nos dois sistemas)
ECL_WEBHOOK_SECRET=ecl-picks-bans-webhook-secret
