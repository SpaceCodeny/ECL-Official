# ============================================================
# Elite Champions League — Backend
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env no repositório.
# ============================================================

# ─── Aplicação ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_NAME=Elite Champions League
APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# ─── Banco de dados ───────────────────────────────────────
# Desenvolvimento local (Docker Compose)
DATABASE_URL=postgresql://ecl:ecl_dev@localhost:5432/ecl?schema=public
# DIRECT_URL é igual ao DATABASE_URL em dev local.
# No Supabase: use a Connection Pooler URL (porta 6543) em DATABASE_URL
# e a Direct Connection (porta 5432) em DIRECT_URL.
DIRECT_URL=postgresql://ecl:ecl_dev@localhost:5432/ecl?schema=public

# Supabase (produção)
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Autenticação JWT ─────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_ACCESS_SECRET=change-me-access-secret-please-use-random-bytes-64
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-random-bytes-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Admin bootstrap ──────────────────────────────────────
# Apenas no seed de desenvolvimento — NÃO usar em produção
ADMIN_BOOTSTRAP_EMAIL=admin@ecl.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!Admin2025
ADMIN_BOOTSTRAP_USERNAME=ecl_admin

# ─── E-mail ───────────────────────────────────────────────
MAIL_PROVIDER=none
MAIL_FROM=noreply@ecl.local
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ─── Uploads ──────────────────────────────────────────────
# "local"    → salva em disco (desenvolvimento)
# "supabase" → envia para Supabase Storage (produção)
UPLOAD_PROVIDER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# Supabase Storage (necessário quando UPLOAD_PROVIDER=supabase)
# Obtenha em: Project Settings > API > service_role key
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=ecl-assets

# ─── Rate limiting ────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60
