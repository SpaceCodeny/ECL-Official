# ═══════════════════════════════════════════════════════════════════════════
# ECL Backend - PRODUÇÃO - Configuração para Vercel Deploy
# ═══════════════════════════════════════════════════════════════════════════
# 
# 🚨 IMPORTANTE: Configure estas variáveis no dashboard da Vercel!
#    Settings → Environment Variables → Add
#
# ═══════════════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=Elite Champions League
APP_URL=https://seu-projeto.vercel.app
CORS_ORIGINS=https://seu-frontend.vercel.app,https://www.seusite.com

# ─── Database (Supabase) ────────────────────────────────────────────────────
# Connection pooling (porta 6543)
DATABASE_URL=postgresql://postgres.xxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (porta 5432) - para migrations
DIRECT_URL=postgresql://postgres.xxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ─── JWT Authentication ─────────────────────────────────────────────────────
# ⚠️  GERE SECRETS SEGUROS: openssl rand -base64 32
JWT_ACCESS_SECRET=GERE-UM-SECRET-ALEATORIO-SEGURO-32-CHARS
JWT_REFRESH_SECRET=GERE-OUTRO-SECRET-DIFERENTE-32-CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Rate Limiting ──────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ─── File Uploads (Supabase Storage) ────────────────────────────────────────
UPLOAD_PROVIDER=supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=ecl-assets
UPLOAD_MAX_SIZE_MB=5

# ─── Email (Opcional) ───────────────────────────────────────────────────────
MAIL_PROVIDER=none
MAIL_FROM=noreply@ecl.com

# ─── Admin Bootstrap (Opcional - para seed) ─────────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=admin@ecl.com
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=SenhaSegura@123456

# ─── Serverless Flag ────────────────────────────────────────────────────────
# ✅ Configurado automaticamente pelo vercel.json - NÃO adicione manualmente!
# SERVERLESS=true
